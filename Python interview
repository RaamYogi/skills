K. String compression:
def compress_string(s):
    if not s:
        return ""

    result = []
    count = 1

    for i in range(1, len(s)):
        if s[i] == s[i - 1]:
            count += 1
        else:
            result.append(s[i - 1] + str(count))
            count = 1

    result.append(s[-1] + str(count))
    return "".join(result)

L. Reverse integer mathematically:
def reverse_int_math(n):
    sign = -1 if n < 0 else 1
    n = abs(n)

    reversed_num = 0

    while n != 0:
        digit = n % 10
        reversed_num = reversed_num * 10 + digit
        n //= 10

    return reversed_num * sign

